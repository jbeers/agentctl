class {

	function parse(required struct cli) {
		var positionals = arguments.cli.positionals;
		var options = arguments.cli.options;
		if (arrayLen(positionals) > 0 && positionals[1] == "docs") {
			if (arrayLen(positionals) > 1) return invalid("docs received too many positional arguments");
			for (var optionName in structKeyArray(options)) {
				if (optionName != "verbose") return invalid("unknown option '--" & optionName & "' for docs");
				if (!isBoolean(options[optionName]) || !options[optionName]) {
					return invalid("option '--verbose' does not accept a value");
				}
			}
			return { valid : true, action : "docs", verbose : structKeyExists(options, "verbose") };
		}
		if (arrayLen(positionals) < 2) {
			return invalid("a namespace and command are required");
		}
		if (positionals[1] != "agent") {
			return invalid("unknown namespace '" & positionals[1] & "'");
		}

		var action = positionals[2];
		if (action != "inspect" && action != "init" && action != "doctor" && action != "rotate" && action != "export" && action != "purge" && action != "up" && action != "status" && action != "open" && action != "ssh" && action != "down") {
			return invalid("unknown agent command '" & action & "'");
		}
		if (arrayLen(positionals) > 2) {
			return invalid("agent " & action & " received too many positional arguments");
		}

		var allowed = action == "inspect" ?
			"file,region,size,hostname,runtime-image,state-archive,workspace-archive,verbose" :
			action == "init" ?
				"file,name,region,size,hostname,runtime-image,dashboard-username,age-recipient,verbose" :
				action == "up" ?
					"file,region,size,hostname,runtime-image,state-archive,workspace-archive,verbose" :
					action == "rotate" ?
						"file,credential,remove,verbose" :
						action == "export" ?
							"file,output,verbose" :
							(action == "status" || action == "open" || action == "ssh" || action == "down") ?
								"file,hostname,verbose" :
								"file,verbose";
		for (var optionName in structKeyArray(options)) {
			if (listFindNoCase(allowed, optionName) == 0) {
				return invalid(
					"unknown option '--" & optionName & "'" &
					(action == "inspect" ? "" : " for agent " & action)
				);
			}
			if (optionName == "verbose" || optionName == "remove") {
				if (!isBoolean(options[optionName]) || !options[optionName]) {
					return invalid("option '--" & optionName & "' does not accept a value");
				}
			} else if (!isStringValue(options[optionName]) || trim(options[optionName]) == "") {
				return invalid("option '--" & optionName & "' requires a value");
			}
		}
		if (action == "init" && structIsEmpty(options)) {
			return {
				valid : true,
				namespace : "agent",
				action : "init",
				wizard : true,
				verbose : false
			};
		}
		if (!structKeyExists(options, "file")) {
			return invalid("agent " & action & " requires '--file'");
		}
		if (action == "init" && !structKeyExists(options, "name")) {
			return invalid("agent init requires '--name'");
		}
		if (action == "rotate" && !structKeyExists(options, "credential")) {
			return invalid("agent rotate requires '--credential'");
		}
		if (action == "export" && !structKeyExists(options, "output")) {
			return invalid("agent export requires '--output'");
		}

		var result = {
			valid : true,
			namespace : "agent",
			action : action,
			file : trim(options.file),
			verbose : structKeyExists(options, "verbose")
		};
		if (action == "rotate") {
			result.credential = lCase(trim(options.credential));
			if (listFind("tailscale-auth-key,registry-token,dashboard-password", result.credential) == 0) {
				return invalid("credential must be tailscale-auth-key, registry-token, or dashboard-password");
			}
			result.remove = structKeyExists(options, "remove");
			if (result.remove && result.credential != "registry-token") {
				return invalid("--remove is supported only for the registry-token credential");
			}
			return result;
		}
		if (action == "export") {
			result.outputPath = trim(options.output);
			return result;
		}
		if (action == "doctor" || action == "purge") {
			return result;
		}

		if (action == "inspect" || action == "up" || action == "status" || action == "open" || action == "ssh" || action == "down") {
			result.overrides = {};
			if (action != "status" && action != "open" && action != "ssh" && action != "down") {
				copyOption(options, "region", result.overrides, "region");
				copyOption(options, "size", result.overrides, "size");
				copyOption(options, "runtime-image", result.overrides, "runtimeImage");
			}
			copyOption(options, "hostname", result.overrides, "hostname");
			if (action == "inspect" || action == "up") {
				copyOption(options, "state-archive", result.overrides, "stateArchive");
				copyOption(options, "workspace-archive", result.overrides, "workspaceArchive");
			}
			return result;
		}

		result.name = trim(options.name);
		result.ageRecipient = structKeyExists(options, "age-recipient") ? trim(options["age-recipient"]) : "";
		result.values = {};
		copyOption(options, "region", result.values, "region");
		copyOption(options, "size", result.values, "size");
		copyOption(options, "hostname", result.values, "hostname");
		copyOption(options, "runtime-image", result.values, "runtimeImage");
		copyOption(options, "dashboard-username", result.values, "dashboardUsername");
		return result;
	}

	private function copyOption(
		required struct options,
		required string optionName,
		required struct target,
		required string targetName
	) {
		if (structKeyExists(arguments.options, arguments.optionName)) {
			arguments.target[arguments.targetName] = trim(arguments.options[arguments.optionName]);
		}
	}

	private function isStringValue(required any value) {
		if (isNull(arguments.value) || !isSimpleValue(arguments.value)) {
			return false;
		}
		var encoded = jsonSerialize(arguments.value);
		return len(encoded) >= 2 && left(encoded, 1) == char(34) && right(encoded, 1) == char(34);
	}

	private function invalid(required string message) {
		return { valid : false, error : arguments.message };
	}

}
