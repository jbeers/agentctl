import src.models.CommandParser;
import src.services.BundleService;
import src.services.CommandRunner;
import src.services.DoctorService;
import src.services.DownService;
import src.services.InitService;
import src.services.OpenService;
import src.services.SshService;
import src.services.StatusService;
import src.services.UpService;

applicationVersion = "__AGENTCTL_VERSION__";
sourceRevision = "__AGENTCTL_REVISION__";

function usage(boolean errorStream = false) {
	var lines = [
		"agentctl",
		"",
		"Usage:",
		"  agentctl docs [--verbose]                                Open the documentation website",
		"  agentctl agent init                                      Interactive wizard",
		"  agentctl agent init --name <name> --file <bundle> [options]",
		"  agentctl agent inspect --file <bundle> [options]",
		"  agentctl agent doctor --file <bundle> [--verbose]",
		"  agentctl agent up --file <bundle> [options]",
		"  agentctl agent status --file <bundle> [--hostname <tailscale-hostname>] [--verbose]",
		"  agentctl agent open --file <bundle> [--hostname <tailscale-hostname>] [--verbose]",
		"  agentctl agent ssh --file <bundle> [--hostname <tailscale-hostname>] [--verbose]",
		"  agentctl agent down --file <bundle> [--hostname <tailscale-hostname>] [--verbose]",
		"",
		"Init options:",
		"  --age-recipient <age1...>    Otherwise use the matching SOPS creation rule",
		"  --region <region>",
		"  --size <droplet-size>",
		"  --hostname <tailscale-hostname>",
		"  --runtime-image <image:tag>",
		"  --dashboard-username <name>",
		"",
		"Inspect/up options:",
		"  --region <region>",
		"  --size <droplet-size>",
		"  --hostname <tailscale-hostname>",
		"  --runtime-image <image:tag>",
		"  --state-archive <path>       Restore fresh Hermes state; never stored in the bundle",
		"  --workspace-archive <path>   Seed fresh /workdir; never stored in the bundle",
		"",
		"Common options:",
		"  --verbose",
		"  --version",
		"",
		"Bundle selection is always explicit; agentctl does not scan the current directory."
	];
	for (var line in lines) {
		systemOutput(line, true, arguments.errorStream);
	}
}

function promptValue(required string label, string defaultValue = "") {
	while (true) {
		var suffix = arguments.defaultValue == "" ? ": " : " [" & arguments.defaultValue & "]: ";
		var value = trim(cliRead(arguments.label & suffix));
		if (value != "") return value;
		if (arguments.defaultValue != "") return arguments.defaultValue;
		systemOutput(arguments.label & " must not be empty.", true, true);
	}
}

function initWizard(required any bundles) {
	systemOutput("Initialize a portable V2 agent bundle. Press Enter to accept a displayed default.", true);
	var name = promptValue("Agent name");
	var defaults = arguments.bundles.parse({ version : 2, identity : { name : name } }).values;
	return {
		action : "init",
		name : name,
		file : promptValue("Bundle path", name & ".agent.yml"),
		values : {
			region : promptValue("DigitalOcean region", defaults.region.value),
			size : promptValue("Droplet size", defaults.computeSize.value),
			hostname : promptValue("Tailscale hostname", defaults.hostname.value),
			runtimeImage : promptValue("Runtime image", defaults.runtimeImage.value),
			dashboardUsername : promptValue("Hermes dashboard username", defaults.dashboardUsername.value)
		},
		ageRecipient : trim(cliRead("Age recipient (leave empty to use a SOPS creation rule): ")),
		verbose : false
	};
}

function confirmedSecret(required string label) {
	while (true) {
		var value = cliReadPassword(arguments.label & ": ");
		if (value == "") {
			systemOutput(arguments.label & " must not be empty.", true, true);
			continue;
		}
		var confirmation = cliReadPassword("Confirm " & lCase(arguments.label) & ": ");
		if (value == confirmation) {
			return value;
		}
		systemOutput("Values did not match; try again.", true, true);
	}
}

function optionalConfirmedSecret(required string label) {
	while (true) {
		var value = cliReadPassword(arguments.label & " (leave empty when not needed): ");
		if (value == "") return "";
		var confirmation = cliReadPassword("Confirm " & lCase(arguments.label) & ": ");
		if (value == confirmation) return value;
		systemOutput("Values did not match; try again.", true, true);
	}
}

cli = cliGetArgs();
if (structKeyExists(cli.options, "version")) {
	systemOutput("agentctl " & applicationVersion & " (revision " & sourceRevision & ")", true);
	exit(0);
}
if (structKeyExists(cli.options, "help") || structKeyExists(cli.options, "h")) {
	usage();
	exit(0);
}

command = new CommandParser().parse(cli);
if (!command.valid) {
	systemOutput("agentctl: " & command.error, true, true);
	systemOutput("", true, true);
	usage(true);
	exit(2);
}

try {
	runner = new CommandRunner();
	if (command.action == "docs") {
		opener = new OpenService(runner);
		result = opener.launchDocumentation(command.verbose);
		systemOutput(opener.format(result), true);
		exit(0);
	}
	bundles = new BundleService(runner);
	if (command.action == "init" && structKeyExists(command, "wizard") && command.wizard) {
		command = initWizard(bundles);
	}
	if (command.action == "inspect") {
		plan = bundles.resolve(command.file, command.overrides);
		if (command.verbose) {
			systemOutput("agent inspect: validated explicit " & (plan.encrypted ? "SOPS-encrypted" : "plaintext") & " bundle", true, true);
		}
		systemOutput(bundles.formatInspection(plan), true);
		exit(0);
	}
	if (command.action == "doctor") {
		doctor = new DoctorService(runner, bundles);
		result = doctor.check(command.file);
		systemOutput(doctor.format(result), true, !result.healthy);
		exit(result.healthy ? 0 : 1);
	}
	if (command.action == "up") {
		up = new UpService(runner);
		result = up.up(
			bundles.resolveForUse(command.file, command.overrides),
			command.verbose,
			structKeyExists(command.overrides, "stateArchive") ? command.overrides.stateArchive : "",
			structKeyExists(command.overrides, "workspaceArchive") ? command.overrides.workspaceArchive : ""
		);
		systemOutput(up.format(result), true);
		exit(0);
	}
	if (command.action == "status") {
		status = new StatusService(runner);
		result = status.check(bundles.resolveForUse(command.file, command.overrides), command.verbose);
		systemOutput(status.format(result), true, !result.ready);
		exit(status.exitCode(result));
	}
	if (command.action == "open") {
		opener = new OpenService(runner);
		result = opener.launch(bundles.resolve(command.file, command.overrides), command.verbose);
		systemOutput(opener.format(result), true);
		exit(0);
	}
	if (command.action == "ssh") {
		ssh = new SshService(runner);
		result = ssh.connect(bundles.resolveForUse(command.file, command.overrides), command.verbose);
		systemOutput(ssh.format(result), true);
		exit(0);
	}
	if (command.action == "down") {
		down = new DownService(runner);
		result = down.down(bundles.resolveForUse(command.file, command.overrides), command.verbose);
		systemOutput(down.format(result), true);
		exit(0);
	}

	initializer = new InitService(runner, bundles);
	prepared = initializer.prepare(command.name, command.file, command.values, command.ageRecipient);
	if (command.verbose) {
		systemOutput("agent init: SOPS encryption and local decryption validated before secret prompts", true, true);
	}
	while (true) {
		tailscaleAuthKey = confirmedSecret("Tailscale enrollment key");
		try {
			initializer.validateTailscaleAuthKey(tailscaleAuthKey);
			break;
		} catch (validationError) {
			systemOutput(validationError.message, true, true);
		}
	}
	dashboardPassword = confirmedSecret("Hermes dashboard password");
	registryToken = optionalConfirmedSecret("Registry pull token");
	target = initializer.create(prepared, tailscaleAuthKey, dashboardPassword, registryToken);
	systemOutput("Created agent bundle '" & target & "'.", true);
	exit(0);
} catch (error) {
	message = structKeyExists(error, "message") ? error.message : "operation failed";
	systemOutput("agentctl: " & message, true, true);
	exit(1);
}
