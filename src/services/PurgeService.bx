class {

	function init(required any commandRunner) {
		variables.runner = arguments.commandRunner;
		return this;
	}

	function prepare(required struct plan) {
		validatePlan(arguments.plan);
		if (!variables.runner.isAvailable("doctl")) fail("doctl is required to purge retained state");
		return providerState(arguments.plan);
	}

	function purge(
		required struct plan,
		required struct prepared,
		required string confirmation,
		boolean verbose = false
	) {
		validatePlan(arguments.plan);
		var name = arguments.plan.values.name.value;
		if (compare(arguments.confirmation, name) != 0) {
			fail("agent purge confirmation did not exactly match the agent name; no state was deleted");
		}
		if (
			!structKeyExists(arguments.prepared, "absent") ||
			arguments.prepared.absent ||
			!structKeyExists(arguments.prepared, "id") ||
			trim(arguments.prepared.id) == ""
		) {
			fail("provider volume changed after inspection; deletion was refused");
		}

		var current = providerState(arguments.plan);
		if (current.absent || compare(current.id, arguments.prepared.id) != 0) {
			fail("provider volume changed after confirmation; deletion was refused");
		}
		runDoctl(
			[ "compute", "volume", "delete", arguments.prepared.id, "--force" ],
			"deleting the exact detached provider volume"
		);
		return {
			absent : false,
			volumeName : current.volumeName,
			id : arguments.prepared.id,
			verbose : arguments.verbose
		};
	}

	function formatWarning(required struct prepared) {
		return joinValues([
			"WARNING: Hermes state will be irreversibly deleted.",
			"  Provider volume: " & arguments.prepared.volumeName,
			"  Verify that a state export or another backup exists if recovery may be needed.",
			"  agentctl does not verify or claim that a backup exists."
		], char(10));
	}

	function format(required struct result) {
		if (arguments.result.absent) {
			return "Provider volume " & arguments.result.volumeName &
				" is already absent; no Hermes state was deleted.";
		}
		var lines = [
			"Deleted provider volume " & arguments.result.volumeName & " (" & arguments.result.id & ").",
			"  Hermes state: irreversibly deleted; this operation cannot be undone",
			"  Backup status: not checked or claimed by agentctl"
		];
		if (arguments.result.verbose) {
			arrayAppend(lines, "  Provider safety: identity and detached state were rechecked immediately before exact-ID deletion");
		}
		return joinValues(lines, char(10));
	}

	private function providerState(required struct plan) {
		var name = arguments.plan.values.name.value;
		var volumeName = arguments.plan.derived.volumeName;
		var droplets = exactRows(
			runDoctl(
				[ "compute", "droplet", "list", "--format", "ID,Name", "--no-header" ],
				"listing DigitalOcean Droplets"
			).output,
			2,
			name
		);
		if (arrayLen(droplets) > 0) {
			fail("agent purge requires the exact-name Droplet to be absent");
		}

		var volumes = exactRows(
			runDoctl(
				[ "compute", "volume", "list", "--format", "ID,Name,Region,Size", "--no-header" ],
				"listing DigitalOcean volumes"
			).output,
			4,
			volumeName
		);
		if (arrayLen(volumes) == 0) {
			return {
				absent : true,
				volumeName : volumeName,
				id : ""
			};
		}
		if (arrayLen(volumes) > 1) {
			fail("multiple exact-name provider volumes exist; state purge was refused");
		}

		var volume = volumes[1];
		if (arrayLen(reMatch("^[A-Za-z0-9-]+$", volume[1])) == 0) {
			fail("provider returned a malformed volume identity; state purge was refused");
		}
		var expectedSize = replace(arguments.plan.values.stateSize.value, "GiB", "", "all");
		if (volume[3] != arguments.plan.values.region.value || volume[4] != expectedSize) {
			fail("provider volume region or size does not match the bundle; state purge was refused");
		}
		var attachments = attachmentIds(volume[1]);
		if (arrayLen(attachments) > 0) {
			fail("provider volume is attached to a Droplet; state purge was refused");
		}
		return {
			absent : false,
			volumeName : volumeName,
			id : volume[1]
		};
	}

	private function attachmentIds(required string volumeId) {
		var response = runDoctl(
			[ "compute", "volume", "get", arguments.volumeId, "--format", "DropletIDs", "--no-header" ],
			"checking provider volume attachments"
		);
		var output = trim(response.output);
		var ids = reMatch("[0-9]+", output);
		if (output != "" && arrayLen(ids) == 0) {
			fail("provider returned malformed volume attachments; state purge was refused");
		}
		return ids;
	}

	private function exactRows(required string output, required numeric columns, required string expectedName) {
		var matches = [];
		var text = trim(replace(arguments.output, char(13), "", "all"));
		if (text == "") return matches;
		for (var line in listToArray(text, char(10), false, true)) {
			var values = reMatch("[^[:space:]]+", line);
			if (arrayLen(values) != arguments.columns) {
				fail("provider returned malformed resource data; state purge was refused");
			}
			if (compare(values[2], arguments.expectedName) == 0) arrayAppend(matches, values);
		}
		return matches;
	}

	private function validatePlan(required struct plan) {
		if (
			!structKeyExists(arguments.plan, "values") ||
			!structKeyExists(arguments.plan, "derived") ||
			arguments.plan.values.computeProvider.value != "digitalocean" ||
			arguments.plan.values.stateStrategy.value != "provider-volume"
		) {
			fail("agent purge requires a DigitalOcean provider-volume bundle");
		}
	}

	private function runDoctl(required array commandArguments, required string label) {
		var result = {};
		try {
			result = variables.runner.run("doctl", arguments.commandArguments);
		} catch (error) {
			fail("DigitalOcean API failure while " & arguments.label & "; state purge was refused");
		}
		if (!succeeded(result)) {
			fail("DigitalOcean API failure while " & arguments.label & "; state purge was refused");
		}
		return result;
	}

	private function succeeded(required struct result) {
		return structKeyExists(arguments.result, "exitCode") &&
			!isNull(arguments.result.exitCode) &&
			arguments.result.exitCode == 0 &&
			(!structKeyExists(arguments.result, "timeout") || !arguments.result.timeout);
	}

	private function joinValues(required array values, required string delimiter) {
		var result = "";
		for (var index = 1; index <= arrayLen(arguments.values); index++) {
			result &= (index == 1 ? "" : arguments.delimiter) & arguments.values[index];
		}
		return result;
	}

	private function fail(required string message) {
		throw arguments.message;
	}

}
