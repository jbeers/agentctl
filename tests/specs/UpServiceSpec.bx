import tests.support.FakeCommandRunner;

class extends="testbox.system.BaseSpec" {

	function run() {
		describe("UpService", () => {
			it("creates private provider resources and reconciles a healthy runtime without exposing secrets", () => {
				var state = providerState();
				var runner = scriptedRunner(state);
				var service = new src.services.UpService(runner, 3, 0);
				var resolved = resolvedBundle("test-agent");
				var result = service.up(resolved, true);
				var output = service.format(result);

				expect(result.dropletCreated).toBeTrue();
				expect(result.volumeCreated).toBeTrue();
				expect(output).toInclude("Agent 'test-agent' is ready.");
				expect(output).toInclude("Workspace/Compose contract: verified");
				expect(output).toInclude("Hermes gateway: healthy at http://test-agent:8642/health");
				expect(output).notToInclude("secret");
				expect(() => yamlDeserialize(state.cloudInit)).notToThrow();
				expect(state.cloudInit).toInclude("tskey-auth-test-up");
				expect(state.cloudInit).toInclude("ssh-ed25519 AAAATESTPUBLIC");
				expect(state.cloudInit).toInclude("[ chage, -d, '-1', -E, '-1', -M, '-1', root ]");
				expect(state.cloudInit).notToInclude("registry-secret");
				expect(state.cloudInit).notToInclude("api-secret");
				expect(state.cloudInit).notToInclude("test-private-material");
				expect(state.payload).toInclude("registry-secret");
				expect(state.payload).toInclude("API_SERVER_KEY=api-secret");
				expect(state.payload).toInclude("HERMES_DASHBOARD_BASIC_AUTH_USERNAME=operator");
				expect(state.payload).toInclude("HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=dashboard-secret");
				expect(state.payload).toInclude("HERMES_DASHBOARD_BASIC_AUTH_SECRET=signing-secret");
				expect(listLen(state.payload, char(10))).toBe(5);
				expect(state.payload).notToInclude("tskey-auth-test-up");
				expect(state.payload).notToInclude("test-private-material");
				expect(state.runtimeScript).notToInclude("telegram");
				expect(state.runtimeScript).toInclude("/usr/local/sbin/agentctl-runtime-v2");
				expect(state.runtimeScript).toInclude("curl --fail --silent");
				expect(state.identityMode).toBe("600");
				expect(state.cloudInitMode).toBe("600");
				expect(state.payloadMode).toBe("600");
				expect(state.scriptMode).toBe("600");
				expect(fileExists(state.identityPath)).toBeFalse();
				expect(fileExists(state.cloudInitPath)).toBeFalse();
				expect(fileExists(state.payloadPath)).toBeFalse();
				expect(fileExists(state.scriptPath)).toBeFalse();

				var dropletCreate = findCall(runner.getCalls(), "doctl", "droplet,create");
				expect(dropletCreate.arguments).toInclude("--user-data-file");
				expect(dropletCreate.arguments).toInclude("ubuntu-24-04-x64");
				expect(dropletCreate.arguments).notToInclude("--ssh-keys");
				var firewallCreate = findCall(runner.getCalls(), "doctl", "firewall,create");
				expect(firewallCreate.arguments).toInclude("--outbound-rules");
				expect(firewallCreate.arguments).toInclude("agentctl-v2");
				for (var call in runner.getCalls()) {
					var argv = jsonSerialize(call.arguments);
					for (var secret in secretValues(resolved)) expect(argv).notToInclude(secret);
					expect(isNull(call.input) ? "" : toString(call.input)).notToInclude("secret");
				}
			});

			it("rejects an invalid state archive before provider inspection or mutation", () => {
				var archive = createTempFile(getSystemSetting("TMPDIR", "/tmp"), "agentctl-invalid-state-", ".tar");
				fileWrite(archive, "archive-private-marker");
				var runner = scriptedRunner(providerState());
				try {
					expect(() => new src.services.UpService(runner, 1, 0).up(resolvedBundle("test-agent"), false, archive)).toThrow(
						message="state archive contains unsafe or invalid entries"
					);
					expect(countCalls(runner.getCalls(), "doctl", "compute")).toBe(0);
					expect(countCalls(runner.getCalls(), "ssh-keygen", "-y")).toBe(0);
					for (var call in runner.getCalls()) expect(jsonSerialize(call.arguments)).notToInclude("archive-private-marker");
				} finally {
					if (fileExists(archive)) fileDelete(archive);
				}
			});

			it("stages and transfers a state archive before seeding or Hermes startup", () => {
				var archive = stateArchive();
				var state = providerState();
				var runner = scriptedRunner(state);
				var service = new src.services.UpService(runner, 1, 0);
				try {
					var result = service.up(resolvedBundle("test-agent"), true, archive);
					var output = service.format(result);
					result.verbose = false;
					var normalOutput = service.format(result);

					expect(output).toInclude("State archive: restored before Hermes startup");
					expect(output).toInclude(getCanonicalPath(archive));
					expect(normalOutput).toInclude("State archive: restored before Hermes startup");
					expect(normalOutput).notToInclude(getCanonicalPath(archive));
					expect(normalOutput).notToInclude("State archive SHA-256:");
					expect(output).toInclude("State archive SHA-256:");
					expect(output).notToInclude("archive-private-marker");
					expect(state.archivePath).notToBe(archive);
					expect(state.archiveMode).toBe("600");
					expect(state.archiveSize).toBeGT(0);
					expect(fileExists(state.archivePath)).toBeFalse();
					expect(state.remoteArchive).toMatch("^root@test-agent:/tmp/agentctl-[a-z0-9]+[.]tar$");
					expect(state.remoteRemovals).toBe(3);
					expect(state.runtimeArguments[arrayLen(state.runtimeArguments) - 1]).toMatch("^/tmp/agentctl-[a-z0-9]+[.]tar$");
					expect(state.runtimeArguments[arrayLen(state.runtimeArguments)]).toBe("-");
					expect(state.runtimeScript).toInclude("python3 - extract");
					expect(find("python3 - extract", state.runtimeScript)).toBeLT(find("env_tmp=$(mktemp", state.runtimeScript));
					for (var call in runner.getCalls()) {
						expect(jsonSerialize(call.arguments)).notToInclude("archive-private-marker");
					}
				} finally {
					if (fileExists(archive)) fileDelete(archive);
				}
			});

			it("seeds a workspace archive and reports that /workdir remains disposable", () => {
				var archive = workspaceArchive();
				var state = providerState();
				var runner = scriptedRunner(state);
				var service = new src.services.UpService(runner, 1, 0);
				try {
					var result = service.up(resolvedBundle("test-agent"), true, "", archive);
					var output = service.format(result);
					result.verbose = false;
					var normalOutput = service.format(result);

					expect(output).toInclude("Workspace archive: seeded before Hermes startup");
					expect(output).toInclude("Workspace persistence: /workdir remains disposable");
					expect(output).toInclude(getCanonicalPath(archive));
					expect(output).notToInclude("workspace-private-marker");
					expect(output).notToInclude("private-work");
					expect(normalOutput).notToInclude(getCanonicalPath(archive));
					expect(state.archivePaths).toHaveLength(1);
					expect(state.archivePaths[1]).toInclude("agentctl-workspace-archive-");
					expect(state.archiveModes[1]).toBe("600");
					expect(fileExists(state.archivePaths[1])).toBeFalse();
					expect(state.runtimeArguments[arrayLen(state.runtimeArguments) - 1]).toBe("-");
					expect(state.runtimeArguments[arrayLen(state.runtimeArguments)]).toMatch("^/tmp/agentctl-[a-z0-9]+[.]tar$");
					expect(state.remoteRemovals).toBe(3);
					for (var call in runner.getCalls()) {
						expect(call.executable).notToBe("git");
						expect(jsonSerialize(call.arguments)).notToInclude("workspace-private-marker");
						expect(jsonSerialize(call.arguments)).notToInclude("private-work");
					}
				} finally {
					if (fileExists(archive)) fileDelete(archive);
				}
			});

			it("restores state and workspace archives to distinct destinations together", () => {
				var stateInput = stateArchive();
				var workspaceInput = workspaceArchive();
				var state = providerState();
				var service = new src.services.UpService(scriptedRunner(state), 1, 0);
				try {
					var result = service.up(resolvedBundle("test-agent"), true, stateInput, workspaceInput);
					var output = service.format(result);

					expect(output).toInclude("State archive: restored before Hermes startup");
					expect(output).toInclude("Workspace archive: seeded before Hermes startup");
					expect(state.archivePaths).toHaveLength(2);
					expect(state.archivePaths[1]).toInclude("agentctl-state-archive-");
					expect(state.archivePaths[2]).toInclude("agentctl-workspace-archive-");
					expect(fileExists(state.archivePaths[1])).toBeFalse();
					expect(fileExists(state.archivePaths[2])).toBeFalse();
					expect(state.runtimeArguments[arrayLen(state.runtimeArguments) - 1]).toMatch("^/tmp/agentctl-[a-z0-9]+[.]tar$");
					expect(state.runtimeArguments[arrayLen(state.runtimeArguments)]).toMatch("^/tmp/agentctl-[a-z0-9]+[.]tar$");
					expect(state.runtimeArguments[arrayLen(state.runtimeArguments) - 1]).notToBe(state.runtimeArguments[arrayLen(state.runtimeArguments)]);
					expect(state.runtimeScript).toInclude('python3 - extract "$state_archive" "$mount_dir"');
					expect(state.runtimeScript).toInclude('python3 - extract "$workspace_archive" /workdir');
					expect(state.remoteRemovals).toBe(4);
				} finally {
					if (fileExists(stateInput)) fileDelete(stateInput);
					if (fileExists(workspaceInput)) fileDelete(workspaceInput);
				}
			});

			it("blocks Hermes and cleans both archives when workspace seeding fails", () => {
				var stateInput = stateArchive();
				var workspaceInput = workspaceArchive();
				var state = providerState({ runtimeExitCode : 54 });
				try {
					expect(() => new src.services.UpService(scriptedRunner(state), 1, 0).up(
						resolvedBundle("test-agent"), false, stateInput, workspaceInput
					)).toThrow(message="workspace is not empty; workspace archive seeding was refused");
					expect(state.runtimeExecutions).toBe(1);
					expect(state.remoteRemovals).toBe(4);
					expect(state.archivePaths).toHaveLength(2);
					for (var path in state.archivePaths) expect(fileExists(path)).toBeFalse();
				} finally {
					if (fileExists(stateInput)) fileDelete(stateInput);
					if (fileExists(workspaceInput)) fileDelete(workspaceInput);
				}
			});

			it("maps remote runtime failures to focused secret-safe stages", () => {
				var cases = [
					{ code : 60, message : "host registry login failed; verify the registry pull credential" },
					{ code : 61, message : "pulling the selected Hermes runtime image failed" },
					{ code : 62, message : "selected Hermes runtime image does not satisfy the Compose contract" },
					{ code : 63, message : "starting the Hermes runtime container failed" },
					{ code : 64, message : "Hermes gateway did not become healthy" },
					{ code : 66, message : "agent host has no usable Tailscale IPv4 address" },
					{ code : 67, message : "configuring the rootless Podman socket failed" },
					{ code : 68, message : "normalizing rootless runtime ownership failed" },
					{ code : 69, message : "runtime credential payload or required Hermes settings validation failed" },
					{ code : 70, message : "writing managed Hermes runtime configuration failed" }
				];
				for (var failureCase in cases) {
					var state = providerState({ runtimeExitCode : failureCase.code });
					expect(() => new src.services.UpService(scriptedRunner(state), 1, 0).up(resolvedBundle("test-agent"))).toThrow(
						message=failureCase.message
					);
					expect(fileExists(state.identityPath)).toBeFalse();
				}
			});

			it("reports a non-empty remote state target without leaking archive details", () => {
				var archive = stateArchive();
				var state = providerState({ runtimeExitCode : 44 });
				var runner = scriptedRunner(state);
				try {
					expect(() => new src.services.UpService(runner, 1, 0).up(resolvedBundle("test-agent"), false, archive)).toThrow(
						message="persistent state is not empty; state archive restore was refused"
					);
					expect(state.remoteRemovals).toBe(3);
					expect(fileExists(state.archivePath)).toBeFalse();
				} finally {
					if (fileExists(archive)) fileDelete(archive);
				}
			});

			it("cleans local and remote archive copies when transfer fails", () => {
				var archive = stateArchive();
				var state = providerState({ failArchiveTransfer : true });
				var runner = scriptedRunner(state);
				try {
					expect(() => new src.services.UpService(runner, 1, 0).up(resolvedBundle("test-agent"), false, archive)).toThrow(
						message="copying the state archive failed"
					);
					expect(state.archivePath).notToBe("");
					expect(fileExists(state.archivePath)).toBeFalse();
					expect(state.remoteRemovals).toBe(1);
					expect(state.runtimeExecutions).toBe(0);
				} finally {
					if (fileExists(archive)) fileDelete(archive);
				}
			});

			it("reuses one exact Droplet and volume while reinstalling the runtime", () => {
				var state = providerState({
					droplets : "101 test-agent",
					volumes : "vol-existing agent-home-test-agent nyc3 10",
					attached : "101",
					tags : "agentctl-v2",
					firewalls : "fw-existing agentctl-private"
				});
				var runner = scriptedRunner(state);
				var result = new src.services.UpService(runner, 1, 0).up(resolvedBundle("test-agent"));

				expect(result.dropletCreated).toBeFalse();
				expect(result.volumeCreated).toBeFalse();
				expect(state.runtimeExecutions).toBe(1);
				expect(state.cloudInit).toBe("");
				expect(findCall(runner.getCalls(), "doctl", "firewall,update").arguments).toInclude("--inbound-rules");
				expect(findCall(runner.getCalls(), "doctl", "tag,apply").arguments).toInclude("do:droplet:101");
				expect(countCalls(runner.getCalls(), "doctl", "droplet,create")).toBe(0);
				expect(countCalls(runner.getCalls(), "doctl", "volume,create")).toBe(0);
				expect(countCalls(runner.getCalls(), "doctl", "volume-action,attach")).toBe(0);
			});

			it("refuses duplicate exact-name Droplets and volumes before mutation", () => {
				var dropletState = providerState({ droplets : "101 test-agent" & char(10) & "102 test-agent" });
				var dropletRunner = scriptedRunner(dropletState);
				expect(() => new src.services.UpService(dropletRunner, 1, 0).up(resolvedBundle("test-agent"))).toThrow(
					message="multiple Droplets named 'test-agent' exist; refusing to choose one"
				);
				expect(mutatingProviderCalls(dropletRunner.getCalls())).toBe(0);

				var volumeState = providerState({
					volumes : "vol-1 agent-home-test-agent nyc3 10" & char(10) & "vol-2 agent-home-test-agent nyc3 10"
				});
				var volumeRunner = scriptedRunner(volumeState);
				expect(() => new src.services.UpService(volumeRunner, 1, 0).up(resolvedBundle("test-agent"))).toThrow(
					message="multiple volumes named 'agent-home-test-agent' exist; refusing to choose one"
				);
				expect(mutatingProviderCalls(volumeRunner.getCalls())).toBe(0);

				var attachmentState = providerState({
					droplets : "101 test-agent",
					volumes : "vol-1 agent-home-test-agent nyc3 10",
					attached : "999"
				});
				var attachmentRunner = scriptedRunner(attachmentState);
				expect(() => new src.services.UpService(attachmentRunner, 1, 0).up(resolvedBundle("test-agent"))).toThrow(
					message="volume 'agent-home-test-agent' is attached to another Droplet"
				);
				expect(mutatingProviderCalls(attachmentRunner.getCalls())).toBe(0);
			});

			it("retries private SSH readiness and replaces only the exact stale host key", () => {
				var state = providerState({
					droplets : "101 test-agent",
					volumes : "vol-existing agent-home-test-agent nyc3 10",
					attached : "101",
					tags : "agentctl-v2",
					firewalls : "fw-existing agentctl-private",
					readinessFailures : 2,
					staleFirst : true
				});
				var runner = scriptedRunner(state);
				var result = new src.services.UpService(runner, 3, 0).up(resolvedBundle("test-agent"));

				expect(result.sshAttempts).toBe(3);
				expect(state.readinessCalls).toBe(3);
				var removal = findCall(runner.getCalls(), "ssh-keygen", "-R,test-agent");
				expect(removal.arguments).toBe([ "-R", "test-agent" ]);
				var retry = findCall(runner.getCalls(), "ssh", "StrictHostKeyChecking=accept-new");
				expect(retry.arguments).toInclude("root@test-agent");
			});

			it("reports DigitalOcean's forced root-password change without exhausting retries", () => {
				var state = providerState({
					droplets : "101 test-agent",
					volumes : "vol-existing agent-home-test-agent nyc3 10",
					attached : "101",
					tags : "agentctl-v2",
					firewalls : "fw-existing agentctl-private",
					readinessFailures : 3,
					passwordExpired : true
				});
				var runner = scriptedRunner(state);
				expect(() => new src.services.UpService(runner, 3, 0).up(resolvedBundle("test-agent"))).toThrow(
					message="agent host has an expired root password; recreate the Droplet with current host enrollment"
				);
				expect(state.readinessCalls).toBe(1);
			});

			it("cleans every local and remote temporary file after runtime failure", () => {
				var state = providerState({ failRuntime : true });
				var runner = scriptedRunner(state);
				expect(() => new src.services.UpService(runner, 1, 0).up(resolvedBundle("test-agent"))).toThrow(
					message="reconciling the Hermes runtime and health endpoint failed"
				);

				for (var path in [ state.identityPath, state.cloudInitPath, state.payloadPath, state.scriptPath ]) {
					expect(path).notToBe("");
					expect(fileExists(path)).toBeFalse();
				}
				expect(state.remoteRemovals).toBe(2);
			});

			it("generates syntax-valid runtime Bash with restore-aware seeding and reconciled settings", () => {
				var script = new src.services.UpService(new FakeCommandRunner()).runtimeScript();
				var syntax = systemExecute("bash", [ "-n", "-c", script ]);

				expect(syntax.exitCode).toBe(0, syntax.error);
				expect(script).toInclude("if [[ -s $env_file ]]");
				expect(script).toInclude('printf ''\n'' >> "$env_tmp"');
				expect(script).notToInclude("tail -c 1");
				expect(script).toInclude('[[ -z $env_tmp ]] || rm -f -- "$env_tmp"');
				expect(script).toInclude('grep -q "^${initial_key}=." "$env_tmp"');
				expect(script).toInclude("persistent state is not empty; state archive restore was refused");
				expect(script).toInclude("archive extraction failed; partial content was removed");
				expect(script).toInclude("Hermes .env must be a regular file");
				expect(script).toInclude('find "$state_restore_target" -mindepth 1 -maxdepth 1 ! -name lost+found -exec rm -rf -- {} +');
				expect(script).toInclude('find "$workspace_restore_target" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +');
				expect(script).toInclude("workspace is not empty; workspace archive seeding was refused");
				expect(script).toInclude('python3 - extract "$workspace_archive" /workdir');
				expect(script).toInclude("state_restore_pending=true");
				expect(script).toInclude("workspace_restore_pending=true");
				expect(script).toInclude('chown -R "$agent_uid:$agent_gid" "$mount_dir"');
				expect(script).toInclude('podman_as_agent unshare find "$mount_dir" /workdir -depth -exec chown -h 10000:10000 -- {} +');
				expect(find('mv "$env_tmp" "$env_file"', script)).toBeLT(find('chown -R "$agent_uid:$agent_gid" "$mount_dir" /workdir || exit 68', script));
				expect(find('chown -R "$agent_uid:$agent_gid" "$mount_dir" /workdir || exit 68', script)).toBeLT(find("--name hermes", script));
				expect(find("python3 - extract", script)).toBeLT(find("env_tmp=$(mktemp", script));
				expect(find('python3 - extract "$workspace_archive" /workdir', script)).toBeLT(find("--name hermes", script));
				expect(find("env_tmp=$(mktemp", script)).toBeLT(find("/etc/agentctl/hermes-launcher.env", script));
				expect(script).toInclude("/etc/agentctl/hermes-launcher.env");
				expect(script).toInclude("HERMES_WRITE_SAFE_ROOT=/opt/data:/workdir");
				expect(script).toInclude("HERMES_MANAGED_DIR=/etc/hermes");
				expect(script).toInclude("terminal:" & char(10) & "  backend: local" & char(10) & "  cwd: /workdir");
				expect(script).toInclude("--workdir /workdir");
				expect(script).toInclude("--volume /workdir:/workdir");
				expect(script).toInclude('"$agent_socket:/run/podman/podman.sock"');
				expect(script).toInclude("/etc/agentctl/hermes-managed:/etc/hermes:ro");
				expect(script).toInclude("command -v podman-compose");
				expect(find("command -v podman-compose", script)).toBeGT(find("--name hermes", script));
				expect(script).notToInclude("podman-compose --version");
				expect(script).notToInclude("image_contract_ready");
				expect(script).notToInclude("runtime_contract_ready");
				expect(script).toInclude("as_agent() {");
				expect(script).toInclude('cd "$agent_home"');
				expect(find('cd "$agent_home"', script)).toBeLT(find("as_agent systemctl --user daemon-reload", script));
				expect(script).toInclude("CONTAINER_HOST=unix:///run/podman/podman.sock");
				expect(script).toInclude("DOCKER_HOST=unix:///run/podman/podman.sock");
				expect(script).toInclude("--password-stdin");
				expect(script).notToInclude("--privileged");
				expect(script).notToInclude("/var/run/docker.sock");
				expect(script).notToInclude("--volume /:/");
				expect(script).notToInclude("podman system service");
				expect(script).notToInclude("git remote");
				expect(script).notToInclude("git status");
				expect(script).notToInclude("telegram");
			});
		});
	}

	private function resolvedBundle(required string name) {
		var plan = new src.services.BundleService().parse({
			version : 2,
			identity : { name : arguments.name },
			runtime : { image : "ghcr.io/example/hermes:sha-test-up" },
			hermes : { initial : { dashboardUsername : "operator" } }
		});
		return {
			plan : plan,
			secretValues : {
				sshPrivateKey : "-----BEGIN OPENSSH PRIVATE KEY-----" & char(10) & "test-private-material" & char(10) & "-----END OPENSSH PRIVATE KEY-----" & char(10),
				tailscaleAuthKey : "tskey-auth-test-up",
				registryToken : "registry-secret",
				apiServerKey : "api-secret",
				dashboardPassword : "dashboard-secret",
				dashboardSecret : "signing-secret"
			}
		};
	}

	private function secretValues(required struct resolved) {
		return [
			arguments.resolved.secretValues.sshPrivateKey,
			arguments.resolved.secretValues.tailscaleAuthKey,
			arguments.resolved.secretValues.registryToken,
			arguments.resolved.secretValues.apiServerKey,
			arguments.resolved.secretValues.dashboardPassword,
			arguments.resolved.secretValues.dashboardSecret
		];
	}

	private function providerState(struct overrides = {}) {
		var state = {
			droplets : "",
			volumes : "",
			attached : "",
			tags : "",
			firewalls : "",
			readinessFailures : 0,
			staleFirst : false,
			passwordExpired : false,
			failRuntime : false,
			runtimeExitCode : 0,
			failArchiveTransfer : false,
			readinessCalls : 0,
			runtimeExecutions : 0,
			remoteRemovals : 0,
			identityPath : "",
			identityMode : "",
			cloudInitPath : "",
			cloudInitMode : "",
			cloudInit : "",
			payloadPath : "",
			payloadMode : "",
			payload : "",
			archivePath : "",
			archiveMode : "",
			archiveSize : 0,
			remoteArchive : "",
			archivePaths : [],
			archiveModes : [],
			archiveSizes : [],
			remoteArchives : [],
			scriptPath : "",
			scriptMode : "",
			runtimeScript : "",
			runtimeArguments : []
		};
		for (var key in structKeyArray(arguments.overrides)) state[key] = arguments.overrides[key];
		return state;
	}

	private function scriptedRunner(required struct state) {
		var handler = (executable, commandArguments, input) => {
			if (arguments.executable == "python3") {
				return systemExecute(arguments.executable, arguments.commandArguments);
			}
			if (arguments.executable == "ssh-keygen") {
				if (arguments.commandArguments[1] == "-y") {
					state.identityPath = arguments.commandArguments[5];
					state.identityMode = fileMode(state.identityPath);
					return success("ssh-ed25519 AAAATESTPUBLIC agentctl:test-agent");
				}
				return success();
			}
			if (arguments.executable == "doctl") {
				var command = arrayToList(arguments.commandArguments, ",");
				if (find("droplet,list", command) > 0) return success(state.droplets);
				if (find("volume,list", command) > 0) return success(state.volumes);
				if (find("volume,get", command) > 0) return success(state.attached);
				if (find("tag,list", command) > 0) return success(state.tags);
				if (find("firewall,list", command) > 0) return success(state.firewalls);
				if (find("volume,create", command) > 0) return success("vol-created");
				if (find("droplet,create", command) > 0) {
					var pathIndex = arrayFind(arguments.commandArguments, "--user-data-file");
					state.cloudInitPath = arguments.commandArguments[pathIndex + 1];
					state.cloudInitMode = fileMode(state.cloudInitPath);
					state.cloudInit = fileRead(state.cloudInitPath);
					return success("202");
				}
				return success();
			}
			if (arguments.executable == "scp") {
				var localPath = arguments.commandArguments[arrayLen(arguments.commandArguments) - 1];
				if (right(localPath, 4) == ".tar") {
					var archiveMode = fileMode(localPath);
					var archiveSize = getFileInfo(localPath).size;
					var remoteArchive = arguments.commandArguments[arrayLen(arguments.commandArguments)];
					arrayAppend(state.archivePaths, localPath);
					arrayAppend(state.archiveModes, archiveMode);
					arrayAppend(state.archiveSizes, archiveSize);
					arrayAppend(state.remoteArchives, remoteArchive);
					if (state.archivePath == "") {
						state.archivePath = localPath;
						state.archiveMode = archiveMode;
						state.archiveSize = archiveSize;
						state.remoteArchive = remoteArchive;
					}
					if (state.failArchiveTransfer) return failure("must-not-leak");
				} else if (right(localPath, 8) == ".payload") {
					state.payloadPath = localPath;
					state.payloadMode = fileMode(localPath);
					state.payload = fileRead(localPath);
				} else {
					state.scriptPath = localPath;
					state.scriptMode = fileMode(localPath);
					state.runtimeScript = fileRead(localPath);
				}
				return success();
			}
			if (arguments.executable == "ssh") {
				var command = arrayToList(arguments.commandArguments, ",");
				if (find("tailscale,status", command) > 0) {
					state.readinessCalls++;
					if (state.readinessCalls <= state.readinessFailures) {
						return failure(
							state.passwordExpired ?
								"You are required to change your password immediately. Password change required but no TTY available." :
								(state.staleFirst && state.readinessCalls == 1 ? "REMOTE HOST IDENTIFICATION HAS CHANGED" : "not ready")
						);
					}
					return success();
				}
				if (find("/bin/bash,/tmp/agentctl-", command) > 0) {
					state.runtimeExecutions++;
					state.runtimeArguments = arguments.commandArguments;
					if (state.runtimeExitCode > 0) return { exitCode : state.runtimeExitCode, output : "", error : "must-not-leak", timeout : false };
					return state.failRuntime ? failure("must-not-leak") : success("healthy");
				}
				if (find("/bin/rm,-f,--,/tmp/agentctl-", command) > 0) state.remoteRemovals++;
				return success();
			}
			return success();
		};
		return new FakeCommandRunner([], true, handler);
	}

	private function stateArchive() {
		var source = createTempDirectory(getSystemSetting("TMPDIR", "/tmp"), "agentctl-state-source-");
		var archive = createTempFile(getSystemSetting("TMPDIR", "/tmp"), "agentctl-state-input-", ".tar");
		try {
			fileWrite(source & "/.env", "ARCHIVE_PRIVATE_MARKER=archive-private-marker");
			fileWrite(source & "/state.txt", "restored");
			var result = systemExecute("tar", [ "-cf", archive, "-C", source, ".env", "state.txt" ]);
			if (result.exitCode != 0) throw "could not create state archive fixture";
			return archive;
		} finally {
			directoryDelete(source, true);
		}
	}

	private function workspaceArchive() {
		var source = createTempDirectory(getSystemSetting("TMPDIR", "/tmp"), "agentctl-workspace-source-");
		var archive = createTempFile(getSystemSetting("TMPDIR", "/tmp"), "agentctl-workspace-input-", ".tar");
		try {
			directoryCreate(source & "/.git");
			fileWrite(source & "/.git/HEAD", "ref: refs/heads/private-work");
			fileWrite(source & "/known.txt", "workspace-private-marker");
			fileWrite(source & "/compose.yaml", "services: {}" & char(10));
			var result = systemExecute("tar", [ "-cf", archive, "-C", source, "." ]);
			if (result.exitCode != 0) throw "could not create workspace archive fixture";
			return archive;
		} finally {
			directoryDelete(source, true);
		}
	}

	private function success(string output = "") {
		return { exitCode : 0, output : arguments.output, error : "", timeout : false };
	}

	private function failure(string error = "failed") {
		return { exitCode : 1, output : "", error : arguments.error, timeout : false };
	}

	private function findCall(required array calls, required string executable, required string commandParts) {
		for (var call in arguments.calls) {
			if (call.executable == arguments.executable && find(arguments.commandParts, arrayToList(call.arguments, ",")) > 0) return call;
		}
		throw "expected command was not called: " & arguments.executable & " " & arguments.commandParts;
	}

	private function countCalls(required array calls, required string executable, required string commandParts) {
		var count = 0;
		for (var call in arguments.calls) {
			if (call.executable == arguments.executable && find(arguments.commandParts, arrayToList(call.arguments, ",")) > 0) count++;
		}
		return count;
	}

	private function mutatingProviderCalls(required array calls) {
		var count = 0;
		for (var call in arguments.calls) {
			if (call.executable != "doctl") continue;
			var command = arrayToList(call.arguments, ",");
			if (find(",create,", "," & command & ",") > 0 || find(",update,", "," & command & ",") > 0 || find("volume-action,attach", command) > 0) count++;
		}
		return count;
	}

	private function fileMode(required string path) {
		return trim(systemExecute("stat", [ "-c", "%a", arguments.path ]).output);
	}

}
