class extends="testbox.system.BaseSpec" {

	function run() {
		describe("CommandParser", () => {
			beforeEach(() => {
				variables.parser = new src.models.CommandParser();
			});

			it("parses inspect with an explicit bundle", () => {
				var result = parser.parse({
					positionals : [ "agent", "inspect" ],
					options : { file : "agents/sample.agent.yml" }
				});

				expect(result.valid).toBeTrue();
				expect(result.action).toBe("inspect");
				expect(result.file).toBe("agents/sample.agent.yml");
			});

			it("requires explicit bundle selection", () => {
				var result = parser.parse({
					positionals : [ "agent", "inspect" ],
					options : {}
				});

				expect(result.valid).toBeFalse();
				expect(result.error).toBe("agent inspect requires '--file'");
			});

			it("starts the init wizard only when no options are supplied", () => {
				var result = parser.parse({
					positionals : [ "agent", "init" ],
					options : {}
				});

				expect(result.valid).toBeTrue();
				expect(result.action).toBe("init");
				expect(result.wizard).toBeTrue();
				expect(parser.parse({
					positionals : [ "agent", "init" ],
					options : { verbose : true }
				}).error).toBe("agent init requires '--file'");
			});

			it("parses init with explicit identity, target, and public choices", () => {
				var result = parser.parse({
					positionals : [ "agent", "init" ],
					options : {
						file : "agents/new-agent.agent.yml",
						name : "new-agent",
						region : "fra1",
						"dashboard-username" : "operator",
						"age-recipient" : "age1testrecipient"
					}
				});

				expect(result.valid).toBeTrue();
				expect(result.action).toBe("init");
				expect(result.name).toBe("new-agent");
				expect(result.ageRecipient).toBe("age1testrecipient");
				expect(result.values.region).toBe("fra1");
				expect(result.values.dashboardUsername).toBe("operator");
			});

			it("requires init identity and target explicitly", () => {
				expect(parser.parse({
					positionals : [ "agent", "init" ],
					options : { name : "new-agent" }
				}).error).toBe("agent init requires '--file'");
				expect(parser.parse({
					positionals : [ "agent", "init" ],
					options : { file : "agent.yml" }
				}).error).toBe("agent init requires '--name'");
			});

			it("parses up with an explicit bundle and public overrides", () => {
				var result = parser.parse({
					positionals : [ "agent", "up" ],
					options : {
						file : "agent.yml",
						region : "fra1",
						"runtime-image" : "ghcr.io/example/hermes:sha-up",
						verbose : true
					}
				});

				expect(result.valid).toBeTrue();
				expect(result.action).toBe("up");
				expect(result.file).toBe("agent.yml");
				expect(result.overrides.region).toBe("fra1");
				expect(result.overrides.runtimeImage).toBe("ghcr.io/example/hermes:sha-up");
				expect(result.verbose).toBeTrue();
				expect(parser.parse({
					positionals : [ "agent", "up" ],
					options : {}
				}).error).toBe("agent up requires '--file'");
				var restore = parser.parse({
					positionals : [ "agent", "up" ],
					options : {
						file : "agent.yml",
						"state-archive" : "state.tar",
						"workspace-archive" : "workspace.tar"
					}
				});
				expect(restore.valid).toBeTrue();
				expect(restore.overrides.stateArchive).toBe("state.tar");
				expect(restore.overrides.workspaceArchive).toBe("workspace.tar");
			});

			it("parses open with an explicit bundle and hostname override", () => {
				var result = parser.parse({
					positionals : [ "agent", "open" ],
					options : { file : "agent.yml", hostname : "test-agent-1", verbose : true }
				});

				expect(result.valid).toBeTrue();
				expect(result.action).toBe("open");
				expect(result.overrides.hostname).toBe("test-agent-1");
				expect(result.verbose).toBeTrue();
				expect(parser.parse({
					positionals : [ "agent", "open" ],
					options : {}
				}).error).toBe("agent open requires '--file'");
				expect(parser.parse({
					positionals : [ "agent", "open" ],
					options : { file : "agent.yml", region : "fra1" }
				}).error).toBe("unknown option '--region' for agent open");
			});

			it("parses status with an explicit bundle and hostname override", () => {
				var result = parser.parse({
					positionals : [ "agent", "status" ],
					options : { file : "agent.yml", hostname : "test-agent-1", verbose : true }
				});

				expect(result.valid).toBeTrue();
				expect(result.action).toBe("status");
				expect(result.overrides.hostname).toBe("test-agent-1");
				expect(result.verbose).toBeTrue();
				expect(parser.parse({
					positionals : [ "agent", "status" ],
					options : {}
				}).error).toBe("agent status requires '--file'");
				expect(parser.parse({
					positionals : [ "agent", "status" ],
					options : { file : "agent.yml", size : "s-2vcpu-4gb" }
				}).error).toBe("unknown option '--size' for agent status");
			});

			it("parses ssh with an explicit bundle and hostname override", () => {
				var result = parser.parse({
					positionals : [ "agent", "ssh" ],
					options : { file : "agent.yml", hostname : "test-agent-1", verbose : true }
				});

				expect(result.valid).toBeTrue();
				expect(result.action).toBe("ssh");
				expect(result.overrides.hostname).toBe("test-agent-1");
				expect(result.verbose).toBeTrue();
				expect(parser.parse({
					positionals : [ "agent", "ssh" ],
					options : {}
				}).error).toBe("agent ssh requires '--file'");
				expect(parser.parse({
					positionals : [ "agent", "ssh" ],
					options : { file : "agent.yml", region : "fra1" }
				}).error).toBe("unknown option '--region' for agent ssh");
			});

			it("parses down with an explicit bundle and access override", () => {
				var result = parser.parse({
					positionals : [ "agent", "down" ],
					options : { file : "agent.yml", hostname : "test-agent-1", verbose : true }
				});

				expect(result.valid).toBeTrue();
				expect(result.action).toBe("down");
				expect(result.file).toBe("agent.yml");
				expect(result.overrides.hostname).toBe("test-agent-1");
				expect(result.verbose).toBeTrue();
				expect(parser.parse({
					positionals : [ "agent", "down" ],
					options : {}
				}).error).toBe("agent down requires '--file'");
				expect(parser.parse({
					positionals : [ "agent", "down" ],
					options : { file : "agent.yml", size : "s-2vcpu-4gb" }
				}).error).toBe("unknown option '--size' for agent down");
			});

			it("parses doctor with only an explicit bundle and verbose", () => {
				var result = parser.parse({
					positionals : [ "agent", "doctor" ],
					options : { file : "agent.yml", verbose : true }
				});

				expect(result.valid).toBeTrue();
				expect(result.action).toBe("doctor");
				expect(result.file).toBe("agent.yml");
				expect(result.verbose).toBeTrue();
				expect(parser.parse({
					positionals : [ "agent", "doctor" ],
					options : { file : "agent.yml", region : "fra1" }
				}).error).toBe("unknown option '--region' for agent doctor");
			});

			it("captures supported CLI overrides and archive intent", () => {
				var result = parser.parse({
					positionals : [ "agent", "inspect" ],
					options : {
						file : "agent.yml",
						region : "fra1",
						size : "s-2vcpu-4gb",
						hostname : "cli-agent",
						"runtime-image" : "ghcr.io/example/hermes:sha-cli",
						"state-archive" : "state.tar",
						"workspace-archive" : "workspace.tar",
						verbose : true
					}
				});

				expect(result.valid).toBeTrue();
				expect(result.overrides.region).toBe("fra1");
				expect(result.overrides.runtimeImage).toBe("ghcr.io/example/hermes:sha-cli");
				expect(result.overrides.stateArchive).toBe("state.tar");
				expect(result.verbose).toBeTrue();
			});

			it("rejects unknown commands, options, values, and extra arguments", () => {
				expect(parser.parse({
					positionals : [ "agent", "unknown" ],
					options : { file : "agent.yml" }
				}).error).toBe("unknown agent command 'unknown'");
				expect(parser.parse({
					positionals : [ "agent", "inspect" ],
					options : { file : "agent.yml", nmae : "typo" }
				}).error).toBe("unknown option '--nmae'");
				expect(parser.parse({
					positionals : [ "agent", "inspect" ],
					options : { file : true }
				}).error).toBe("option '--file' requires a value");
				expect(parser.parse({
					positionals : [ "agent", "inspect", "agent.yml" ],
					options : { file : "agent.yml" }
				}).error).toBe("agent inspect received too many positional arguments");
			});
		});
	}

}
