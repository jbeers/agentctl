class extends="testbox.system.BaseSpec" {

	function run() {
		describe("Hermes runtime image and Compose contract", () => {
			it("builds from a pinned Hermes image with an explicit Compose client", () => {
				var containerfile = fileRead(projectPath("Containerfile"));
				var ignore = fileRead(projectPath(".containerignore"));

				expect(trim(listFirst(ignore, char(10)))).toBe("*");
				expect(containerfile).toInclude("nousresearch/hermes-agent@sha256:");
				expect(containerfile).notToInclude("hermes-agent:latest");
				expect(containerfile).toInclude("podman-compose");
				expect(containerfile).toInclude("CONTAINER_HOST=unix:///run/podman/podman.sock");
				expect(containerfile).toInclude("DOCKER_HOST=unix:///run/podman/podman.sock");
				expect(containerfile).toInclude("WORKDIR /workdir");
				expect(containerfile).toInclude("USER hermes");
				expect(containerfile).notToInclude("--privileged");
			});

			it("keeps generated archive validation compatible with the native MatchBox runtime", () => {
				var archiveService = fileRead(projectPath("src/services/ArchiveService.bx"));

				expect(archiveService).notToInclude("arrayToList");
				expect(new src.services.ArchiveService({}).validatorProgram()).toInclude("def extract_archive");
			});

			it("provides a Compose fixture that proves path parity and sibling health", () => {
				var fixtureDirectory = projectPath("tests/fixtures/compose-workspace");
				var compose = yamlDeserialize(fileRead(fixtureDirectory & "/compose.yaml"));
				var probe = compose.services["workspace-probe"];

				expect(trim(fileRead(fixtureDirectory & "/known.txt"))).toBe("agentctl-compose-ok");
				expect(probe.working_dir).toBe("/workspace");
				expect(jsonSerialize(probe.command)).toInclude("cat known.txt");
				expect(jsonSerialize(probe.command)).toInclude("httpd -f -p 18080");
				expect(jsonSerialize(probe.volumes)).toInclude("COMPOSE_WORKSPACE_PATH");
				expect(jsonSerialize(probe.volumes)).toInclude("PATH:-.}:/workspace:ro");
				expect(jsonSerialize(probe.volumes)).toInclude("scratch:/scratch");
				expect(jsonSerialize(probe.ports)).toInclude("18080:18080");
				expect(jsonSerialize(probe.healthcheck.test)).toInclude("http://127.0.0.1:18080/known.txt");
				expect(structKeyExists(compose.volumes, "scratch")).toBeTrue();
			});
		});
	}

	private function projectPath(required string relativePath) {
		return getCanonicalPath(getDirectoryFromPath(getCurrentTemplatePath()) & "../../" & arguments.relativePath);
	}

}
