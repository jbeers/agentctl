import tests.support.FakeCommandRunner;

class extends="testbox.system.BaseSpec" {

	function run() {
		describe("ArchiveService", () => {
			it("stages and extracts a valid state tree without changing restored configuration", () => {
				var archive = makeArchive("valid");
				var target = makeDirectory();
				directoryCreate(target & "/lost+found");
				var service = new src.services.ArchiveService(new src.services.CommandRunner());
				var prepared = {};
				try {
					prepared = service.prepare(archive);
					expect(prepared.sourcePath).toBe(getCanonicalPath(archive));
					expect(prepared.temporaryPath).notToBe(archive);
					expect(fileMode(prepared.temporaryPath)).toBe("600");
					expect(prepared.size).toBeGT(0);
					expect(prepared.digest).toMatch("^[a-f0-9]{64}$");

					var result = runExtraction(service, prepared.temporaryPath, target);
					expect(result.exitCode).toBe(0, result.error);
					expect(trim(fileRead(target & "/.env"))).toBe("RESTORED_VALUE=authoritative");
					expect(trim(fileRead(target & "/config/value.txt"))).toBe("restored-state");
					expect(fileMode(target & "/bin/tool")).toBe("755");
					expect(systemExecute("stat", [ "-c", "%i", target & "/config/value.txt" ]).output).toBe(
						systemExecute("stat", [ "-c", "%i", target & "/config/value-hard" ]).output
					);
				} finally {
					cleanupPrepared(prepared);
					cleanupPath(archive);
					cleanupPath(target);
				}
			});

			it("resolves a relative source from the operator working directory", () => {
				var generated = makeArchive("valid");
				var name = ".agentctl-relative-state-" & lCase(reReplace(createUUID(), "[^a-z0-9]", "", "all")) & ".tar";
				var archive = getSystemSetting("PWD", getCanonicalPath(".")) & "/" & name;
				var prepared = {};
				fileCopy(generated, archive);
				fileDelete(generated);
				try {
					prepared = new src.services.ArchiveService(new src.services.CommandRunner()).prepare(name);
					expect(prepared.sourcePath).toBe(archive);
				} finally {
					cleanupPrepared(prepared);
					cleanupPath(archive);
				}
			});

			it("rejects missing, directory, symlink, and unreadable archive sources", () => {
				var service = new src.services.ArchiveService(new src.services.CommandRunner());
				var directory = makeDirectory();
				var archive = makeArchive("valid");
				var link = archive & ".link";
				var fifo = directory & "/source.fifo";
				systemExecute("ln", [ "-s", archive, link ]);
				systemExecute("mkfifo", [ fifo ]);
				try {
					for (var path in [ directory & "/missing.tar", directory, link, fifo ]) {
						expect(() => service.prepare(path)).toThrow(
							message="state archive must be a readable regular tar file"
						);
					}
					fileSetAccessMode(archive, "000");
					expect(() => service.prepare(archive)).toThrow(
						message="state archive must be a readable regular tar file"
					);
				} finally {
					fileSetAccessMode(archive, "600");
					cleanupPath(link);
					cleanupPath(archive);
					cleanupPath(directory);
				}
			});

			it("rejects traversal, absolute paths, escaping links, and special files", () => {
				var service = new src.services.ArchiveService(new src.services.CommandRunner());
				for (var scenario in [ "traversal", "absolute", "symlink", "hardlink", "fifo", "device", "socket" ]) {
					var archive = makeArchive(scenario);
					try {
						expect(() => service.prepare(archive)).toThrow(
							message="state archive contains unsafe or invalid entries"
						);
					} finally {
						cleanupPath(archive);
					}
				}
			});

			it("refuses a non-empty target without merging or overwriting it", () => {
				var archive = makeArchive("valid");
				var target = makeDirectory();
				fileWrite(target & "/existing.txt", "keep-me");
				var service = new src.services.ArchiveService(new src.services.CommandRunner());
				var prepared = {};
				try {
					prepared = service.prepare(archive);
					var result = runExtraction(service, prepared.temporaryPath, target);
					expect(result.exitCode).toBe(4);
					expect(result.error).toInclude("persistent state is not empty");
					expect(result.error).notToInclude("existing.txt");
					expect(fileRead(target & "/existing.txt")).toBe("keep-me");
					expect(fileExists(target & "/.env")).toBeFalse();
				} finally {
					cleanupPrepared(prepared);
					cleanupPath(archive);
					cleanupPath(target);
				}
			});

			it("removes partial restored content when extraction fails", () => {
				var archive = makeArchive("partial-failure");
				var target = makeDirectory();
				var service = new src.services.ArchiveService(new src.services.CommandRunner());
				var prepared = {};
				try {
					prepared = service.prepare(archive);
					var result = runExtraction(service, prepared.temporaryPath, target);
					expect(result.exitCode).toBe(5);
					expect(result.error).toBe("state archive extraction failed; partial restored state was removed");
					expect(directoryList(target)).toHaveLength(0);
				} finally {
					cleanupPrepared(prepared);
					cleanupPath(archive);
					cleanupPath(target);
				}
			});

			it("sanitizes validator failures and removes its temporary copy", () => {
				var archive = createTempFile(getSystemSetting("TMPDIR", "/tmp"), "agentctl-invalid-", ".tar");
				fileWrite(archive, "private archive bytes that must not leak");
				var before = temporaryArchiveCount();
				try {
					expect(() => new src.services.ArchiveService(new src.services.CommandRunner()).prepare(archive)).toThrow(
						message="state archive contains unsafe or invalid entries"
					);
					expect(temporaryArchiveCount()).toBe(before);
				} finally {
					cleanupPath(archive);
				}
			});
		});
	}

	private function runExtraction(required any service, required string archive, required string target) {
		return systemExecute(
			"python3",
			[ "-c", arguments.service.validatorProgram(), "extract", arguments.archive, arguments.target ]
		);
	}

	private function makeArchive(required string scenario) {
		var path = createTempFile(getSystemSetting("TMPDIR", "/tmp"), "agentctl-archive-fixture-", ".tar");
		var script = arrayToList([
			"import io, sys, tarfile",
			"path, scenario = sys.argv[1:3]",
			"def add_file(archive, name, content, mode=0o600):",
			"    data = content.encode()",
			"    member = tarfile.TarInfo(name)",
			"    member.size = len(data)",
			"    member.mode = mode",
			"    archive.addfile(member, io.BytesIO(data))",
			"with tarfile.open(path, 'w', format=tarfile.PAX_FORMAT) as archive:",
			"    if scenario == 'valid':",
			"        add_file(archive, '.env', 'RESTORED_VALUE=authoritative' + chr(10))",
			"        add_file(archive, 'config/value.txt', 'restored-state' + chr(10), 0o640)",
			"        add_file(archive, 'bin/tool', chr(10).join(('##!/bin/sh', 'exit 0', '')), 0o755)",
			"        link = tarfile.TarInfo('config/value-link')",
			"        link.type = tarfile.SYMTYPE",
			"        link.linkname = 'value.txt'",
			"        archive.addfile(link)",
			"        hard = tarfile.TarInfo('config/value-hard')",
			"        hard.type = tarfile.LNKTYPE",
			"        hard.linkname = 'config/value.txt'",
			"        archive.addfile(hard)",
			"    elif scenario == 'traversal':",
			"        add_file(archive, '../escape', 'blocked')",
			"    elif scenario == 'absolute':",
			"        add_file(archive, '/tmp/escape', 'blocked')",
			"    elif scenario == 'symlink':",
			"        link = tarfile.TarInfo('unsafe-link')",
			"        link.type = tarfile.SYMTYPE",
			"        link.linkname = '../../escape'",
			"        archive.addfile(link)",
			"    elif scenario == 'hardlink':",
			"        link = tarfile.TarInfo('unsafe-hardlink')",
			"        link.type = tarfile.LNKTYPE",
			"        link.linkname = '../../escape'",
			"        archive.addfile(link)",
			"    elif scenario == 'fifo':",
			"        member = tarfile.TarInfo('unsafe-fifo')",
			"        member.type = tarfile.FIFOTYPE",
			"        archive.addfile(member)",
			"    elif scenario == 'device':",
			"        member = tarfile.TarInfo('unsafe-device')",
			"        member.type = tarfile.CHRTYPE",
			"        member.devmajor = 1",
			"        member.devminor = 3",
			"        archive.addfile(member)",
			"    elif scenario == 'socket':",
			"        member = tarfile.TarInfo('unsafe-socket')",
			"        member.type = b's'",
			"        archive.addfile(member)",
			"    elif scenario == 'partial-failure':",
			"        add_file(archive, 'created-before-failure.txt', 'remove-me')",
			"        add_file(archive, 'x' * 300, 'cannot-create')"
		], char(10));
		var result = systemExecute("python3", [ "-c", script, path, arguments.scenario ]);
		if (result.exitCode != 0) throw "could not create archive fixture";
		return path;
	}

	private function makeDirectory() {
		var path = createTempDirectory(getSystemSetting("TMPDIR", "/tmp"), "agentctl-archive-target-");
		return path;
	}

	private function cleanupPrepared(required struct prepared) {
		if (structKeyExists(arguments.prepared, "temporaryPath")) cleanupPath(arguments.prepared.temporaryPath);
	}

	private function cleanupPath(required string path) {
		if (directoryExists(arguments.path)) {
			directoryDelete(arguments.path, true);
		} else if (fileExists(arguments.path)) {
			fileDelete(arguments.path);
		}
	}

	private function fileMode(required string path) {
		return trim(systemExecute("stat", [ "-c", "%a", arguments.path ]).output);
	}

	private function temporaryArchiveCount() {
		var result = systemExecute("bash", [ "-c", "find " & getSystemSetting("TMPDIR", "/tmp") & " -maxdepth 1 -name 'agentctl-state-archive-*.tar' -printf x | wc -c" ]);
		return val(trim(result.output));
	}

}
