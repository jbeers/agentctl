class {

	function init(array responses = [], any available = true, any handler = null) {
		variables.responses = arguments.responses;
		variables.available = arguments.available;
		variables.handler = arguments.handler;
		variables.calls = [];
		variables.availabilityChecks = [];
		return this;
	}

	function run(
		required string executable,
		array commandArguments = [],
		numeric timeout = 0,
		boolean terminateOnTimeout = false,
		any directory = null,
		any output = null,
		any error = null,
		boolean inheritEnvironment = true,
		struct environment = {},
		boolean inheritIO = false,
		any input = null
	) {
		arrayAppend(variables.calls, {
			executable : arguments.executable,
			arguments : arguments.commandArguments,
			inheritIO : arguments.inheritIO,
			input : arguments.input
		});
		if (!isNull(variables.handler)) {
			return variables.handler(arguments.executable, arguments.commandArguments, arguments.input);
		}
		if (arrayLen(variables.responses) > 0) {
			var response = variables.responses[1];
			arrayDeleteAt(variables.responses, 1);
			return response;
		}
		return { exitCode : 0, output : "", error : "", timeout : false };
	}

	function isAvailable(required string executable) {
		arrayAppend(variables.availabilityChecks, arguments.executable);
		if (isStruct(variables.available) && structKeyExists(variables.available, arguments.executable)) {
			return variables.available[arguments.executable];
		}
		return isBoolean(variables.available) ? variables.available : true;
	}

	function getCalls() {
		return variables.calls;
	}

	function getAvailabilityChecks() {
		return variables.availabilityChecks;
	}

}
